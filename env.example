# Copy this file to "$(herdr plugin config-dir alherdr.agent-alerts)/dotenv",
# or just run scripts/wizard.sh and let it do the whole setup for you.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Numeric chat id that receives the alerts. Required.
# Message your bot once and read getUpdates to find it; the wizard does this.
TELEGRAM_CHAT_ID=

# Agent statuses that trigger an alert, comma separated.
# Available: blocked, done, idle, working, unknown
# blocked = the agent is waiting for your answer or approval
# done    = the agent finished its turn (idle is the already-seen variant)
ALHERDR_STATUSES=blocked,done

# Alert when an agent stops occupying its pane, or when its process exits.
# released = agent left the pane (quit, killed, or replaced)
# exited   = the pane's foreground process ended (crash, exit, Ctrl-D)
ALHERDR_ALERT_RELEASED=1
ALHERDR_ALERT_EXITED=1

# Lines pulled from the agent pane when building the alert digest.
ALHERDR_DIGEST_LINES=40

# Longest digest body sent to Telegram, in characters (Telegram caps at 4096).
ALHERDR_DIGEST_MAX_CHARS=1200

# Suppress a repeat alert for the same pane and kind within this window.
ALHERDR_DEDUPE_SECONDS=30

# Default enable state, until a toggle action writes its own state file.
ALHERDR_ENABLED=1

# Set to 1 to print the rendered alert instead of sending it.
ALHERDR_DRY_RUN=0
